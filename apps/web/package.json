{
  "name": "@renewlet/client",
  "private": true,
  "license": "MIT",
  "version": "0.3.26",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit --project tsconfig.app.json && vite build && node scripts/check-client-csp.mjs && node scripts/check-client-bundle-budget.mjs",
    "build:docker-sidecars": "node scripts/generate-static-sidecars.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint . --max-warnings 0 && node scripts/check-tailwind-canonical-classes.mjs && node scripts/check-form-field-layout.mjs",
    "i18n:check": "node ../../scripts/check-i18n-catalogs.mjs",
    "i18n:extract": "lingui extract --clean --overwrite && node ../../scripts/generate-i18n-artifacts.mjs",
    "test": "vitest",
    "test:perf": "vitest run .performance.test.tsx",
    "test:run": "vitest run --exclude '**/*.performance.test.tsx'",
    "typecheck": "tsc --noEmit --project tsconfig.app.json",
    "typecheck:all": "tsc --noEmit --project tsconfig.json --incremental false"
  },
